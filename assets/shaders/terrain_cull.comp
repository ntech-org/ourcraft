#version 430 core

layout(local_size_x = 64) in;

struct DrawElementsIndirectCommand {
    uint count;
    uint instanceCount;
    uint firstIndex;
    int  baseVertex;
    uint baseInstance;
};

struct SectionData {
    mat4 model;
    vec4 aabbMin;
    vec4 aabbMax;
};

layout(std430, binding = 0) readonly buffer SectionBuffer {
    SectionData sections[];
};

layout(std430, binding = 1) buffer CommandBuffer {
    DrawElementsIndirectCommand commands[];
};

uniform vec4 uFrustumPlanes[6];

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= commands.length()) return;

    vec3 bmin = sections[idx].aabbMin.xyz;
    vec3 bmax = sections[idx].aabbMax.xyz;

    for (int i = 0; i < 6; i++) {
        vec3 p;
        p.x = (uFrustumPlanes[i].x > 0.0) ? bmax.x : bmin.x;
        p.y = (uFrustumPlanes[i].y > 0.0) ? bmax.y : bmin.y;
        p.z = (uFrustumPlanes[i].z > 0.0) ? bmax.z : bmin.z;
        if (dot(uFrustumPlanes[i].xyz, p) + uFrustumPlanes[i].w < 0.0) {
            commands[idx].count = 0u;
            return;
        }
    }
}
